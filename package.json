{
	"name": "autofeeds",
	"version": "1.0.0",
	"description": "A feed bot for Stoat that supports RSS, Atom, JSON, and podcast feeds.",
	"main": "main.ts",
	"scripts": {
		"start": "bun main.ts",
		"dev": "bun main.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"json-with-bigint": "^3.5.11",
		"mysql2": "^3.23.3",
		"rss-parser": "^3.13.0"
	},
	"keywords": [
		"stoat",
		"rss",
		"atom",
		"json-feed",
		"podcast",
		"bot",
		"feeds"
